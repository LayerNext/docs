        "operationId": "get-api-datasets-list",
        "description": "Get a list of dataset groups that are created under your team plus all versions under each group."
      },
      "parameters": []
    },
    "/api/datasets/{datasetVersionId}/downloadDataset": {
      "parameters": [
        {
          "schema": {
            "type": "string"
          },
          "name": "datasetVersionId",
          "in": "path",
          "required": true,
          "description": "ID of the required version of relevant dataset group. This id can be taken from response of Dataset List endpoint."
        }
      ],
      "get": {
        "summary": "Download Dataset",
        "tags": [],
        "responses": {},
        "operationId": "get-api-datasets-datasetVersionId-downloadDataset",
        "description": "Returns training data and urls of images for all frames (both real and augmented) in given export format",
        "parameters": [
          {
            "schema": {
              "type": "number"
            },
            "in": "query",
            "name": "pageIndex",
            "description": "Index of the page of data frames (default = 0)"
          },
          {
            "schema": {
              "type": "number"
            },
            "in": "query",
            "name": "pageSize",
            "description": "No of frames contained in each page (default 100 and maximum is 10000)"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "exportFormat",
            "description": "Output format of data (accepted formats are: yolo, rcnn, tensorflow)",
            "required": true
          }
        ]
      }
    },
    "/api/datasets/{datasetGroupId}/create": {
      "parameters": [
        {
          "schema": {
            "type": "string"
          },
          "name": "datasetGroupId",
          "in": "path",
          "required": true,
          "description": "ID of the dataset group under which this version to be created. This ID can be retrieved from the Dataset List endpoint response."
        }
      ],
      "post": {
        "summary": "Create Dataset Version",
        "operationId": "post-api-datasets-datasetGroupId-create",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "",
                "type": "object",
                "properties": {
                  "trainingSetPercentage": {
                    "type": "number"
                  },
                  "testingSetPercentage": {
                    "type": "number"
                  },
                  "validationSetPercentage": {
                    "type": "number"
                  }
                },
                "required": [
                  "trainingSetPercentage",
                  "testingSetPercentage",
                  "validationSetPercentage"
                ],
                "x-examples": {
                  "example-1": {
                    "trainingSetPercentage": 69,
                    "testingSetPercentage": 20,
                    "validationSetPercentage": 11
                  }
                }
              }
            }
          },
          "description": "The percentages to which the dataset should be split for training, testing and validation. Make sure the sum of percentages equals 100."
        },
        "description": "Creates a dataset version under required dataset group using given projects. You can input the split percentage for 3 categories that are required for ML process - training / testing and validation."
      }
    },
    "/api/datasets/createGroup": {
      "post": {
        "summary": "Create Dataset Group",
        "operationId": "post-api-datasets-createGroup",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Before creating a dataset, a group should be created. ",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "",
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name"
                ],
                "x-examples": {
                  "example-1": {
                    "name": "My Dataset Group"
                  }
                }
              }
            }
          },
          "description": "Only a name should be provided to create a group."
        }
      }
    }
